<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="roblox_auth.xml"/>
        <exclude
            domain="sharedpref"
            path="start_cache.xml"/>
        <exclude
            domain="root"
            path="app_webview/"/>
        <exclude
            domain="database"
            path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="roblox_auth.xml"/>
        <exclude
            domain="sharedpref"
            path="start_cache.xml"/>
        <exclude
            domain="root"
            path="app_webview/"/>
        <exclude
            domain="database"
            path="."/>
    </device-transfer>
</data-extraction-rules>
